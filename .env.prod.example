# Copy to `.env.prod` (gitignored) and fill in. Consumed by `just db-prod-up`,
# which ships it to the host as the `.env` beside `compose.prod.yaml`.

# The password for the `tt` Postgres role on the real database.
TT_PG_PASSWORD=change-me

# The host address Postgres binds to. Use the host's Tailscale IP so the database
# is reachable only over the tailnet, never the LAN or the public internet.
TT_PG_BIND=100.99.222.96

# Host port to publish on. Pick a free one; the host may already run Postgres on 5432.
TT_PG_PORT=54329

(library
 (name tt)
 (libraries
  yojson
  ppx_yojson_conv_lib
  caqti
  caqti.blocking
  caqti-driver-sqlite3
  cmdliner
  notty-community
  unix
  uri)
 (preprocess
  (pps ppx_yojson_conv ppx_deriving_jsonschema))
 ; Warning 8 is non-exhaustive match. It is an error in dune's dev profile but
 ; only a warning under --profile release, so a release build will happily
 ; compile a match that is missing a case and raise Match_failure at runtime.
 ; Promoting it here makes exhaustiveness fatal in every profile, which is the
 ; whole reason for using a closed variant.
 (flags
  (:standard -warn-error +8)))

; The schema is one file, read by two things: dune embeds it here so the store
; can apply it, and Atlas diffs migrations/ against it. Neither has a copy.

(rule
 (target schema.ml)
 (deps schema.sql)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(** The text of [schema.sql], embedded at build time. *)\n\nlet ddl = {sql|")
    (cat %{deps})
    (echo "|sql}\n")))))

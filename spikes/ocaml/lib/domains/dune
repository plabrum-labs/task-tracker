; The schema is one file, read by two things: dune embeds it here so the store
; can apply it, and Atlas diffs migrations/ against it. Neither has a copy.
;
; It sits above the per-object directories because it declares both tables, and
; the issues table's foreign key means they cannot be stated apart.

(rule
 (target schema.ml)
 (deps schema.sql)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(** The text of [schema.sql], embedded at build time. *)\n\nlet ddl = {sql|")
    (cat %{deps})
    (echo "|sql}\n")))))

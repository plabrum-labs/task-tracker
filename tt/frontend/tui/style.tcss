/* Every colour is a theme ``$`` variable, so a theme switch repaints with no
   hardcoded hex. ``ansi_default`` lets the terminal's own background show through
   rather than painting one over it. */

Screen {
    background: ansi_default;
}

/* --- the browse screen --------------------------------------------------- */

TopBar {
    height: 1;
    padding: 0 1;
    margin: 1 0 0 0;
}

/* The facets in force, one row under the header. The widget hides itself when
   nothing is filtered, giving the row back to the body. Each chip is ``width: auto``
   so it hugs its text rather than taking the default ``1fr`` share of the row; the
   hint after them takes the slack. */
ChipsBar {
    height: 1;
    padding: 0 1;
}
.chip {
    width: auto;
    margin-right: 1;
    padding: 0 1;
    background: $primary 14%;
    color: $foreground;
}
.chip-hint {
    width: 1fr;
    padding-left: 1;
}

#content {
    height: 1fr;
}

/* The ultra-wide band's third column, left of the list: the grouping, the facets in
   force and the saved views, standing instead of hidden behind their overlays. Hidden
   here and shown by the screen, which is what owns the width band. */
Rail {
    display: none;
    width: 30;
    height: 1fr;
    padding: 0 1;
    border-right: solid $border;
}
/* ``auto``, not ``1``: a height of one is the whole box, so the blank line above
   would push the head's own line out of it. */
.rail-head {
    height: auto;
    padding-top: 1;
}
.rail-row {
    height: auto;
    padding-left: 1;
    color: $foreground;
}
.rail-empty {
    height: 1;
    padding-left: 1;
    color: $text-disabled;
}
/* A chip in the rail is the chips bar's, stacked down a column rather than along a
   row: ``width: auto`` so the tint hugs its text instead of filling the rail. */
.rail-chip {
    width: auto;
    height: auto;
    margin-left: 1;
    padding: 0 1;
    background: $primary 14%;
    color: $foreground;
}

Body {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
}

/* The read detail and the edit form share the right pane's slot: one shows while
   the other is display:none, so they carry the same geometry. EditPane starts
   hidden — the screen reveals it for an action with fields. */
DetailPane, EditPane {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    border-left: solid $border;
}
EditPane {
    display: none;
}

/* On a thin column the ``#content`` row becomes a stack: the pane drops under the
   list, taking the full width and only the height its detail needs (up to half),
   its dividing border moving from the left edge to the top. */
#content.below {
    layout: vertical;
}
#content.below DetailPane, #content.below EditPane {
    width: 1fr;
    height: auto;
    max-height: 50%;
    border-left: none;
    border-top: solid $border;
}
.d-header {
    height: auto;
    padding-bottom: 1;
}
.d-meta {
    height: auto;
}
.d-body {
    height: auto;
    padding-top: 1;
    color: $foreground;
}
.d-empty {
    color: $text-disabled;
}

/* What the issue is filed under, above the body: a label column against the value
   cells, one tight row per relation the issue carries. The chips and pills are
   widgets, so the tint is a background rather than markup; each is ``width: auto`` so
   it hugs its text instead of taking the default ``1fr`` share of the row. */
.d-attrs {
    height: auto;
    padding-top: 1;
}
.d-attr {
    height: auto;
}
.d-attr-label {
    width: 11;
    color: $text-muted;
}
.d-attr-value {
    width: 1fr;
    padding: 0 1;
    color: $foreground;
}
.lchip {
    width: auto;
    padding: 0 1;
    background: $primary 14%;
    color: $foreground;
}
.tagpill {
    width: auto;
    margin-right: 1;
    padding: 0 1;
    background: $border;
    color: $text-muted;
}

/* How a set of issues stands, in a line: what it is, what it is filed under, the
   bar, and the per-status counts. The counts cell takes the slack so the cells
   before it hug their text. */
RollupRow {
    height: auto;
    padding-top: 1;
}
.r-id {
    width: auto;
    padding-right: 2;
    color: $foreground;
}
.r-related {
    width: auto;
    padding-right: 2;
}
.r-bar {
    width: auto;
    padding-right: 2;
}
.r-counts {
    width: 1fr;
}

/* The comment thread under the body. A row is the flat list's shape — the same
   gutter bar over a fixed-width column and a filling one — but grown to the height
   its wrapped body needs rather than pinned to a single line. */
.d-comment-head {
    height: auto;
    padding-top: 1;
}
CommentRow {
    height: auto;
    padding-top: 1;
}
CommentRow.sel {
    background: $primary 14%;
}
.d-comment-date {
    width: 6;
    color: $text-muted;
}
.d-comment-body {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

/* The dependency lists under the comment thread: a section head, a labelled
   sub-head per list, and muted read-only ref rows — no gutter bar and no cursor,
   since nothing walks them. */
.d-dep-head {
    height: auto;
    padding-top: 1;
}
.d-dep-sub {
    height: auto;
    padding-top: 1;
}
.d-dep {
    height: auto;
    padding-left: 2;
    color: $text-muted;
}

/* The edit form inside the pane. Its boxes sit on the terminal background like the
   read detail beside them — not on the modal ``$overlay`` — so the accent is the
   only paint; the focused box takes it. */
.e-header {
    height: auto;
    padding-bottom: 1;
}
EditPane Input {
    border: round $border;
    height: 3;
    margin: 0 1;
    padding: 0 1;
    background: ansi_default;
}
EditPane Input:focus {
    border: round $primary;
}
EditPane Input > .input--placeholder {
    color: $text-disabled;
}
EditPane Select {
    margin: 0 1;
}

/* The prose split: the body editor takes the pane's remaining height on the left,
   the scalars a narrow column on its right. The row itself is what claims the
   leftover space (``1fr``); the title above and the footer below stay ``auto``. */
.e-split {
    height: 1fr;
}
.e-content {
    width: 2fr;
    height: 1fr;
}
.e-attrs {
    width: 1fr;
    height: 1fr;
    min-width: 22;
}
EditPane TextArea {
    height: 1fr;
    min-height: 6;
    margin: 0 1;
    border: round $border;
    background: ansi_default;
}
EditPane TextArea:focus {
    border: round $primary;
}

/* Stacked under the list, the two columns cannot sit side by side in a short
   pane, so the split becomes a stack and the body editor takes a fixed height. */
#content.below .e-split {
    layout: vertical;
    height: auto;
}
#content.below .e-content,
#content.below .e-attrs {
    width: 1fr;
    height: auto;
}
#content.below EditPane TextArea {
    height: 8;
}

/* Two rows, not one: the rule the border draws is a row of the box, so a height of
   one leaves the text nothing to sit on and the bar reads as a bare line. The filter
   carries the same border and height, so swapping one for the other does not move
   the row the text sits on. */
StatusBar {
    dock: bottom;
    height: 2;
    border-top: solid $border;
    padding: 0 1;
}

FilterInput {
    dock: bottom;
    height: 2;
    border: none;
    border-top: solid $border;
    padding: 0 1;
    background: ansi_default;
    /* Hidden until ``/`` — and while hidden it is not focusable, so browse keys
       reach the screen bindings instead of being typed into it. */
    display: none;
}

/* --- the flat list row --------------------------------------------------- */

IssueRow {
    height: 1;
}
IssueRow.sel {
    background: $primary 14%;
}
.bar {
    width: 2;
    color: $primary;
}
.glyph {
    width: 2;
}
.st-todo {
    color: $text-muted;
}
.st-doing {
    color: $warning;
}
.st-done {
    color: $success;
}
.ref {
    width: 10;
    padding-right: 1;
    color: $text-muted;
}
.waiting {
    width: 2;
}
.title {
    width: 1fr;
    color: $foreground;
}
.title.done {
    color: $text-muted;
}
.pri {
    width: 9;
    text-align: right;
    padding-right: 1;
}
.empty {
    padding: 0 2;
}

/* --- the groups ---------------------------------------------------------- */

/* A group's header is the rollup row. Stacked, it sits over its issues indented past
   the gutter the rows draw their cursor bar in; in a column it heads the cards with
   no gutter to clear. */
/* The whole padding, not just the left: a rule that sets one edge replaces the
   inherited spacing outright, so naming the left alone would drop the blank line the
   base row keeps above itself. */
Body RollupRow {
    padding: 1 0 0 2;
}

/* A second dimension nests inside the first, so its headers and the issues under them
   step in one indent — the outer level's headers stay the spine the eye follows down
   the page. The gutter the rows draw their cursor bar in is two cells wide, so a
   header indents by two more than the rows it heads to line their text up. Two levels
   is the cap, so ``lvl-1`` is the only nesting depth there is. */
Body RollupRow.lvl-1 {
    padding: 0 0 0 4;
}

/* A header standing for an epic, a milestone or a tag is a place the cursor lands, so
   it carries the selection the way a row does. */
Body RollupRow.sel {
    background: $primary 14%;
}
IssueRow.lvl-1 {
    padding-left: 2;
}

/* The columns lay across a row; the wrapper is what makes their ``1fr`` widths
   divide the width rather than each take all of it. */
.board {
    width: 1fr;
    height: auto;
}
GroupColumn {
    width: 1fr;
    height: auto;
    padding: 0 1;
}
GroupColumn RollupRow {
    padding: 0 0 1 0;
}
Card {
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}
Card.sel {
    background: $primary 14%;
}

/* --- the modal overlays -------------------------------------------------- */

/* No scrim: the browse screen stays at full brightness behind the floating panel,
   the way lazygit draws its popups. The panel's own ``$overlay`` fill and accent
   border are what set it apart from the content it covers. */
MenuScreen, CaptureScreen, SettingsScreen, CheatsheetScreen {
    align: center top;
    background: transparent;
}

/* ``$overlay``, not ``$panel``: under ``ansi=True`` the stock surface tokens are
   transparent, so a panel painted with them would let the content behind show
   straight through it. The pinned hex keeps the floating panel opaque. */
#panel {
    width: 56;
    height: auto;
    margin-top: 3;
    padding: 1 1;
    background: $overlay;
    color: $overlay-text;
    border: round $primary;
}

.ov-header {
    padding: 0 1;
    height: 1;
}
.ov-foot {
    padding: 1 1 0 1;
}

/* The menu's search box and list sit flush inside the panel. Input and OptionList
   each default their own ``color`` to ``$foreground``, so the pinned overlay text
   is set on them explicitly rather than inherited from ``#panel``. */
#panel Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: $overlay;
    color: $overlay-text;
}
#panel Input > .input--placeholder {
    color: $overlay-text-disabled;
}
#panel OptionList {
    height: auto;
    max-height: 20;
    border: none;
    padding: 0;
    background: $overlay;
    color: $overlay-text;
}
/* The highlighted row takes the same accent tint the browse list uses, so the
   menu's selection reads the same as the screen behind it. */
#panel OptionList > .option-list--option-highlighted {
    background: $primary 14%;
    color: $overlay-text;
    text-style: none;
}

/* The menu's filter stays hidden until ``/`` reveals it — the menu opens focused
   on the list. Scoped by id so the always-shown capture box is not caught. */
#menu-filter {
    display: none;
}

.f-label {
    padding: 0 1;
    height: 1;
}
.f-error {
    padding: 0 1;
    height: auto;
}
.cheat {
    height: 1;
    padding: 0 1;
}
